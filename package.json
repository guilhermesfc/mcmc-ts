{
  "name": "mcmc-ts",
  "version": "0.2.0",
  "description": "Minimal, typed MCMC samplers in TypeScript",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -w -p tsconfig.json",
    "type-check": "tsc -p tsconfig.dev.json",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run format:check && npm run type-check && npm run build && npm test",
    "example:gaussian": "tsx examples/gaussian.ts",
    "example:halfnormal": "tsx examples/halfnormal.ts",
    "example:plot": "tsx examples/plot-gaussian.ts"
  },
  "keywords": [
    "mcmc",
    "metropolis-hastings",
    "bayesian",
    "typescript",
    "sampler"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "sideEffects": false,
  "author": "Guilherme Costa",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.10.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guilhermesfc/mcmc-ts.git"
  },
  "homepage": "https://github.com/guilhermesfc/mcmc-ts#readme",
  "bugs": {
    "url": "https://github.com/guilhermesfc/mcmc-ts/issues"
  },
  "engines": {
    "node": ">=18"
  }
}
